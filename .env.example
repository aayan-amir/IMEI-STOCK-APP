NODE_ENV=development
PORT=3000
# Writes require a MongoDB replica set, including local development.
MONGO_URI=mongodb://127.0.0.1:27017/stockly_development?replicaSet=rs0
TRUST_PROXY=false
# Set an explicit secret to enable platform administration.
SUPER_ADMIN_PASSWORD=
# Exact cross-origin clients only; same-origin browser requests always work.
ALLOWED_ORIGINS=capacitor://localhost,http://localhost,https://localhost
STOCKTAKES_ENABLED=false
FULLY_PAID_SALES_ENABLED=false
CUSTOMER_RETURNS_ENABLED=false
VERIFIED_CASH_ENABLED=false
