# ── Required ───────────────────────────────────────────────────────────────────
# MongoDB connection string (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/phone-stock

# Auth passwords — must be set; server refuses to start if either is missing
# Use a long, random string for each (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
GATE_PASSWORD=REPLACE_WITH_STRONG_GATE_PASSWORD
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ── Optional ───────────────────────────────────────────────────────────────────
# Server port (Render sets this automatically)
PORT=3000

# Set to production in hosted environments
NODE_ENV=production

# Reverse-proxy trust (true | false | integer hop count)
# Render sits behind one proxy layer, so 1 is correct
TRUST_PROXY=1

# Comma-separated list of valid shop identifiers
# Defaults to: 456,192,G15
# VALID_SHOPS=456,192,G15
